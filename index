<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sterlion Finance — Payment Ledger</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');
:root{--ink:#101a2c;--ink-soft:#4a5568;--paper:#f7f2e7;--white:#fff;--line:#ddd1b0;--gold:#b8863b;--gold-deep:#8c6428;--ok:#3f6d5c;--warn:#a23b3b;--pending:#f0ead9}
*{box-sizing:border-box}html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);font-family:Inter,Arial,sans-serif}
body.auth-required #app,body.auth-required #userbar{visibility:hidden} body.authenticated #auth-gate{display:none!important}
#auth-gate{position:fixed;inset:0;background:var(--paper);z-index:99999;display:flex;align-items:center;justify-content:center;padding:24px}
.auth-card{width:min(430px,100%);background:#fff;border:1px solid var(--line);border-radius:8px;padding:30px;box-shadow:0 15px 50px #101a2c18}
.auth-card h2{font-family:Fraunces,serif;font-size:28px;margin:0 0 8px}.auth-card p{font-size:12px;color:var(--ink-soft);line-height:1.5}
.auth-card label{display:block;font-size:11px;margin:14px 0 5px}.auth-card input{width:100%;padding:11px;border:1px solid #cfc6ad;border-radius:4px;font-size:14px}
.auth-card button{width:100%;padding:11px;margin-top:16px;border:0;border-radius:4px;background:var(--ink);color:#fff;cursor:pointer}
.auth-error{color:var(--warn);font-size:12px;margin-top:10px;min-height:18px}
#userbar{position:fixed;right:18px;top:15px;z-index:9000;background:#fff;border:1px solid var(--line);border-radius:5px;padding:7px 9px;font:11px "IBM Plex Mono",monospace;display:none}
body.authenticated #userbar{display:block}.user-role{color:var(--gold-deep);font-weight:600}.userbar-btn{border:0;background:var(--ink);color:#fff;padding:5px 8px;margin-left:8px;border-radius:3px;cursor:pointer}

#app{min-height:100vh;padding-bottom:60px}
.header{background:var(--ink);color:#fff;padding:20px 32px 22px;position:relative}
.header:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:repeating-linear-gradient(90deg,var(--gold) 0 10px,transparent 10px 20px);opacity:.75}
.header-inner{max-width:1280px;margin:auto}
.brand-row{display:flex;align-items:center;gap:18px}
.brand-logo{width:190px;height:68px;background:#fff;border-radius:5px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex:0 0 auto;padding:4px 8px}
.brand-logo img{display:block;width:100%;height:100%;object-fit:contain;background:#fff}
.title-block h1{font:600 31px Fraunces,serif;margin:0}.title-block p{font:10px "IBM Plex Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:4px 0 0}
.stats{display:flex;gap:34px;margin-top:18px;flex-wrap:wrap}.stat-label{font:10px "IBM Plex Mono",monospace;text-transform:uppercase;letter-spacing:.1em;opacity:.65}.stat-value{font:600 21px "IBM Plex Mono",monospace;margin-top:3px}.gold{color:var(--gold)}.green{color:#8fd6bb}

.notice{max-width:1280px;margin:0 auto;padding:12px 32px;font-size:11px;color:var(--ink-soft)}
.layout{max-width:1280px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:330px 1fr;gap:28px}
.card{background:#fffdf8;border:1px solid var(--line);border-radius:6px;padding:20px}.card h2,.ledger-title{font:600 20px Fraunces,serif;margin:0}.sub{font-size:11.5px;color:var(--ink-soft);line-height:1.45;margin:5px 0 17px}
label{display:block;font-size:11px;font-weight:600;margin:13px 0 5px}input,select,textarea{width:100%;padding:9px 10px;border:1px solid #cfc6ad;border-radius:4px;background:#fff;color:var(--ink);font:13px Inter,Arial,sans-serif}textarea{min-height:70px;resize:vertical}
.amount-words{font:11px "IBM Plex Mono",monospace;color:var(--gold-deep);min-height:16px;margin-top:5px}
.btn{border:0;border-radius:4px;padding:9px 12px;cursor:pointer;font:600 11px "IBM Plex Mono",monospace}.btn-primary{width:100%;margin-top:16px;background:var(--ink);color:#fff}.btn-ghost{background:transparent;color:var(--ink-soft);border:1px solid var(--line)}.btn-gold{background:var(--gold);color:#fff}.btn-danger{background:var(--warn);color:#fff}
.dropzone{border:1.5px dashed var(--line);padding:15px;text-align:center;border-radius:4px;background:#fbf8f1;cursor:pointer;font-size:12px;color:var(--ink-soft)}.dropzone b{color:var(--gold-deep)}
.form-error,.form-msg{font-size:12px;margin-top:9px}.form-error{color:var(--warn)}.form-msg{color:var(--ok)}
.save-banner{display:none;max-width:1280px;margin:0 auto 12px;padding:0 32px}.save-banner.show{display:block}.banner{padding:9px 12px;border-radius:4px;font-size:12px}.banner.ok{background:#e4ede9;color:var(--ok)}.banner.error{background:#f3e3e0;color:var(--warn)}

.ledger-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}.controls{display:flex;gap:7px;flex-wrap:wrap}.filter-btn{border:1px solid var(--line);background:transparent;border-radius:18px;padding:6px 11px;font:10px "IBM Plex Mono",monospace;text-transform:uppercase;cursor:pointer;color:var(--ink-soft)}.filter-btn.active{background:var(--ink);color:#fff;border-color:var(--ink)}.search{width:210px;border-radius:18px}
.nbfc-row{margin-bottom:14px}
.ledger{border-top:1px solid var(--line)}.row{display:grid;grid-template-columns:70px 1fr auto auto auto;gap:14px;align-items:center;padding:13px 5px;border-bottom:1px solid #e7dfca;cursor:pointer}.thumb{width:60px;height:45px;object-fit:cover;border-radius:3px;border:1px solid var(--line)}.thumb.placeholder{display:flex;align-items:center;justify-content:center;background:#f1ecdf;color:#aaa}.customer{font-weight:600;font-size:13px}.meta{font:10px "IBM Plex Mono",monospace;color:var(--ink-soft);margin-top:3px}.amount{font:600 13px "IBM Plex Mono",monospace}.status{font:10px "IBM Plex Mono",monospace;text-transform:uppercase;padding:4px 7px;border-radius:12px;background:var(--pending)}.status.paid{background:#e4ede9;color:var(--ok)}.status.overdue{background:#f3e3e0;color:var(--warn)}.status.partial{background:#fbe9c8;color:#8a5a00}.detail{grid-column:1/-1;border-top:1px dashed var(--line);padding:13px 0 3px;display:grid;grid-template-columns:1fr 220px;gap:18px}.detail-notes{font-size:12px;color:var(--ink-soft);line-height:1.5}.detail-proof img{width:100%;border:1px solid var(--line);border-radius:4px}.detail-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.empty{text-align:center;padding:50px 20px;color:var(--ink-soft)}.empty .big{font:20px Fraunces,serif;color:var(--ink);margin-bottom:5px}.loading{text-align:center;padding:50px;color:var(--ink-soft);font:12px "IBM Plex Mono",monospace}

.import-box{margin-top:20px;padding-top:18px;border-top:1px dashed var(--line)}.import-box p{font-size:11px;color:var(--ink-soft);line-height:1.45}.import-files{margin-top:18px}.import-file-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #e7dfca}.import-file-name{font-size:12px;font-weight:700;overflow-wrap:anywhere}.import-file-meta{font:10px "IBM Plex Mono",monospace;color:var(--ink-soft);margin-top:3px}.term-box{margin-top:20px;border:1px solid #d8c49a;background:#fffaf0;border-radius:6px;padding:14px}.term-box h3{font:600 17px Fraunces,serif;margin:0 0 5px}.term-box p{font-size:11px;color:var(--ink-soft);margin:0 0 10px}
@media(max-width:900px){.layout{grid-template-columns:1fr}.brand-row{align-items:flex-start}.row{grid-template-columns:55px 1fr auto}.row>.status{grid-column:3}.detail{grid-template-columns:1fr}.search{width:100%}}
@media(max-width:600px){.header,.layout,.notice{padding-left:15px;padding-right:15px}.brand-logo{width:160px;height:58px;padding:3px 6px}.title-block h1{font-size:25px}.stats{gap:20px}.row{grid-template-columns:50px 1fr}.amount{grid-column:2}.status{grid-column:2!important;justify-self:start}}
.btn-danger:disabled{opacity:.55;cursor:wait}.delete-policy-help{margin-top:10px;padding:8px 10px;border:1px solid #e8d7b7;background:#fffaf0;border-radius:5px;font-size:10px;line-height:1.45;color:#6d6252}.delete-policy-help code{font-family:monospace}</style>
</head>
<body class="auth-required">

<div id="auth-gate">
  <div class="auth-card">
    <h2>Payment Ledger Login</h2>
    <p>Sign in to continue.</p>
    <label>Email</label><input id="auth-email" type="email" autocomplete="username" placeholder="Email">
    <label>Password</label><input id="auth-password" type="password" autocomplete="current-password" placeholder="Password">
    <button id="auth-login">Sign in</button>
    <button id="team-view-btn" class="btn btn-ghost" style="width:100%;margin-top:8px">Team View — Read Only</button>
    <div id="auth-error" class="auth-error"></div>
  </div>
</div>

<div id="team-pin-gate" style="display:none;position:fixed;inset:0;background:var(--paper);z-index:100000;align-items:center;justify-content:center;padding:24px">
  <div class="auth-card">
    <h2>Team View</h2><p>Enter the team-view PIN.</p>
    <input id="team-pin" type="password" placeholder="PIN">
    <button id="team-pin-btn">View Ledger</button>
    <div id="team-pin-error" class="auth-error"></div>
  </div>
</div>

<div id="userbar"><span id="auth-user-email"></span> <span id="auth-role" class="user-role"></span><button id="auth-logout" class="userbar-btn">Sign out</button></div>

<div id="app">
  <header class="header">
    <div class="header-inner">
      <div class="brand-row">
        <div class="brand-logo" aria-label="Sterlion Finance">
          <img src="data:image/png;base64," alt="Sterlion Finance">
        </div>
        <div class="title-block">
          <h1>Payment Ledger</h1>
        </div>
      </div>
      <div class="stats">
        <div><div class="stat-label">Entries</div><div id="stat-count" class="stat-value">—</div></div>
        <div><div class="stat-label">Outstanding</div><div id="stat-outstanding" class="stat-value gold">—</div></div>
        <div><div class="stat-label">Collected</div><div id="stat-collected" class="stat-value green">—</div></div>
      </div>
    </div>
  </header>

  <div class="notice">Shared payment ledger. Monedo, Blacksoil, Fintree and Term Loan are kept in separate filters. Imported files are stored as batches and can be deleted completely by Admin.</div>
  <div id="save-banner" class="save-banner"><div id="banner" class="banner"></div></div>

  <main class="layout">
    <section class="card">
      <h2 id="form-title">New Entry</h2>
      <p class="sub">Add a customer due/payment or update a Term Loan payment.</p>

      <label>Customer name</label><input id="f-customer" placeholder="Customer name">
      <label>Loan / NBFC</label>
      <select id="f-nbfc">
        <option value="">Select…</option>
        <option>Monedo</option><option>Blacksoil</option><option>Fintree</option><option>Term Loan</option>
      </select>
      <label>Invoice / Reference No.</label><input id="f-invoice" placeholder="Invoice / reference">
      <label>Customer WhatsApp number (optional)</label><input id="f-phone" placeholder="e.g. 919876543210 (with country code)">
      <label>Virtual Account No. (optional)</label><input id="f-van" placeholder="e.g. MONEDOSC48676">
      <label>Amount (₹)</label><input id="f-amount" type="number" min="0" step="0.01" placeholder="Amount">
      <div id="amount-words" class="amount-words"></div>
      <label>Amount Paid so far (₹) — leave 0 if nothing paid yet</label><input id="f-paid" type="number" min="0" step="0.01" placeholder="0" value="0">
      <label>Due date</label><input id="f-due" type="date">
      <label>Notes</label><textarea id="f-notes" placeholder="Payment details / remarks"></textarea>
      <label>Payment proof (optional)</label>
      <div id="dropzone" class="dropzone"><b>Click to upload</b> or drop screenshot here</div>
      <input id="f-file" type="file" accept="image/*" style="display:none">
      <div id="form-error" class="form-error" style="display:none"></div>
      <div id="form-msg" class="form-msg" style="display:none"></div>
      <button id="submit-btn" class="btn btn-primary">Save entry</button>
      <button id="cancel-edit" class="btn btn-ghost" style="display:none;width:100%;margin-top:8px">Cancel edit</button>

      <div id="import-section" class="import-box">
        <label style="margin-top:0">Bulk import</label>
        <p>Upload Excel/CSV. Accepted columns: Customer, NBFC, Invoice, Amount, Due Date, Notes, Status. If the file has its own NBFC column, that value wins for each row. Otherwise, pick the lender below and every row in this file will be tagged with it.</p>
        <label style="margin-top:10px">This file is for</label>
        <select id="import-nbfc" style="width:100%;padding:9px 10px;border:1px solid #cfc6ad;border-radius:4px;background:#fff;color:var(--ink);font-size:13px">
          <option value="">Detect automatically (from filename)</option>
          <option value="Monedo">Monedo</option>
          <option value="Blacksoil">Blacksoil</option>
          <option value="Fintree">Fintree</option>
          <option value="Term Loan">Term Loan</option>
        </select>
        <button id="import-btn" class="btn btn-ghost" style="width:100%;margin-top:10px">Import Excel / CSV</button>
        <input id="import-file" type="file" accept=".xlsx,.xls,.csv" style="display:none">
        <div id="import-status" style="font-size:12px;margin-top:8px"></div>
      </div>

      <div id="van-section" class="import-box">
        <label style="margin-top:0">Update Virtual Account Numbers</label>
        <p>Upload a file with columns customer_name, Virtual Account Number (and optionally IFSC code / Beneficiary Name). Matches each customer already in the ledger by name and fills in their VAN on every one of their invoices.</p>
        <select id="van-nbfc" style="width:100%;padding:9px 10px;border:1px solid #cfc6ad;border-radius:4px;background:#fff;color:var(--ink);font-size:13px">
          <option value="">Apply to: all NBFCs (match by name only)</option>
          <option value="Monedo">Apply to: Monedo entries only</option>
          <option value="Blacksoil">Apply to: Blacksoil entries only</option>
          <option value="Fintree">Apply to: Fintree entries only</option>
          <option value="Term Loan">Apply to: Term Loan entries only</option>
        </select>
        <button id="van-btn" class="btn btn-ghost" style="width:100%;margin-top:10px">Update VAN from file</button>
        <input id="van-file" type="file" accept=".xlsx,.xls,.csv" style="display:none">
        <div id="van-status" style="font-size:12px;margin-top:8px"></div>
      </div>

      <div class="term-box">
        <h3>Term Loan</h3>
        <p>Use <b>Term Loan</b> to add a payment, update a payment, or view only Term Loan records.</p>
        <button id="term-filter-btn" class="btn btn-gold" style="width:100%">Open Term Loan Payments</button>
      </div>

      <div id="import-files" class="import-files">
        <h3 style="font:600 17px Fraunces,serif;margin:0 0 4px">Imported Files</h3>
        <p style="font-size:11px;color:var(--ink-soft);margin:0 0 8px">Each import is stored as a batch. Delete a file here to remove all entries from that import.</p>
        <div id="file-list"><div class="loading" style="padding:20px">Loading imported files…</div></div>
      </div>
    </section>

    <section>
      <div class="ledger-head">
        <h2 class="ledger-title">Entries</h2>
        <input id="search" class="search" placeholder="Search customer or invoice…">
        <button id="group-toggle" class="filter-btn">Group by Customer</button>
        <div class="controls">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="pending">Pending</button>
          <button class="filter-btn" data-filter="overdue">Overdue</button>
          <button class="filter-btn" data-filter="partial">Partially paid</button>
          <button class="filter-btn" data-filter="paid">Paid</button>
        </div>
      </div>
      <div class="controls nbfc-row">
        <button class="filter-btn active" data-nbfc="">All</button>
        <button class="filter-btn" data-nbfc="Monedo">Monedo</button>
        <button class="filter-btn" data-nbfc="Blacksoil">Blacksoil</button>
        <button class="filter-btn" data-nbfc="Fintree">Fintree</button>
        <button class="filter-btn" data-nbfc="Term Loan">Term Loan</button>
      </div>
      <div id="ledger" class="ledger"><div class="loading">Loading ledger…</div></div>
    </section>
  </main>
</div>

<script>
(function(){
"use strict";

/* ---------- Supabase ---------- */
const SB_URL="https://uocykxumgbgbvzqxfugf.supabase.co";
const SB_KEY="sb_publishable_B5XqzTHrNjPKS_72YCXBUA_aArekkB8";
let accessToken=null,currentUser=null,currentIsAdmin=false;
try{
  const s=JSON.parse(localStorage.getItem("sterlion-auth-session")||"null");
  if(s&&s.access_token) accessToken=s.access_token;
}catch(e){}

async function sb(path,options={}){
  const headers=Object.assign({"apikey":SB_KEY,"Content-Type":"application/json","Accept":"application/json"},options.headers||{});
  headers.Authorization="Bearer "+(accessToken||SB_KEY);
  const res=await fetch(SB_URL+"/rest/v1/"+path,Object.assign({},options,{headers}));
  const text=await res.text();
  if(!res.ok) throw new Error("Supabase HTTP "+res.status+": "+text);
  if(!text)return null; try{return JSON.parse(text)}catch(e){return text}
}

/* ---------- helpers ---------- */
const state={records:[],filter:"all",nbfc:"",search:"",editingId:null,pendingImage:null,openId:null,groupByCustomer:false,openCustomer:null};
const $=id=>document.getElementById(id);
// Repayment account details per NBFC — edit these as you get details from
// other lenders. Virtual Account No. comes from each entry's own "van"
// field instead, since that's usually unique per customer.
const NBFC_ACCOUNTS={
  "Monedo":{name:"Monedo Financial Services Private Limited",ifsc:"AUBL0REMMIT"},
  "Blacksoil":{name:"",ifsc:""},
  "Fintree":{name:"",ifsc:""},
  "Term Loan":{name:"",ifsc:""}
};
function uid(){return "p"+Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function money(n){return "₹"+(Number(n)||0).toLocaleString("en-IN",{maximumFractionDigits:0})}
function today(){return new Date().toISOString().slice(0,10)}
function outstandingOf(r){return Math.max(0,(Number(r.amount)||0)-(Number(r.paidAmount)||0))}
function statusOf(r){
  if(r.status==="paid"||outstandingOf(r)<=0)return"paid";
  if((Number(r.paidAmount)||0)>0)return"partial";
  if(r.due&&r.due<today())return"overdue";
  return"pending";
}
function esc(v){const d=document.createElement("div");d.textContent=v==null?"":String(v);return d.innerHTML}
const ones=["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
const tens=["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
function two(n){return n<20?ones[n]:tens[Math.floor(n/10)]+(n%10?" "+ones[n%10]:"")}
function three(n){let h=Math.floor(n/100),r=n%100,s=h?ones[h]+" Hundred":"";return s+(r?(s?" ":"")+two(r):"")}
function indianWords(n){n=Math.round(Number(n)||0);if(!n)return"Zero Rupees Only";let c=Math.floor(n/1e7);n%=1e7;let l=Math.floor(n/1e5);n%=1e5;let t=Math.floor(n/1e3);n%=1e3;let a=[];if(c)a.push(three(c)+" Crore");if(l)a.push(three(l)+" Lakh");if(t)a.push(three(t)+" Thousand");if(n)a.push(three(n));return a.join(" ")+" Rupees Only"}
function fmtDate(s){if(!s)return"—";const p=s.split("-");return p.length===3?`${p[2]}-${p[1]}-${p[0]}`:s}
function banner(msg,type="ok"){ $("save-banner").classList.add("show");$("banner").className="banner "+type;$("banner").textContent=msg;if(type==="ok")setTimeout(()=>$("save-banner").classList.remove("show"),2500)}

/* ---------- robust date parser ---------- */
function parseDate(v){
  if(v===null||v===undefined||v==="")return"";
  if(v instanceof Date&&!isNaN(v)){return `${v.getFullYear()}-${String(v.getMonth()+1).padStart(2,"0")}-${String(v.getDate()).padStart(2,"0")}`}
  if(typeof v==="number"){
    const d=new Date(Date.UTC(1899,11,30)+v*86400000);
    return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}-${String(d.getUTCDate()).padStart(2,"0")}`;
  }
  let s=String(v).trim();
  s=s.replace(/\s+\d{1,2}:\d{2}(:\d{2})?.*$/,"");
  let m=s.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/);
  if(m){let d=+m[1],mo=+m[2],y=+m[3];if(d>=1&&d<=31&&mo>=1&&mo<=12)return `${y}-${String(mo).padStart(2,"0")}-${String(d).padStart(2,"0")}`}
  m=s.match(/^(\d{4})[\/.-](\d{1,2})[\/.-](\d{1,2})$/);
  if(m)return `${m[1]}-${String(+m[2]).padStart(2,"0")}-${String(+m[3]).padStart(2,"0")}`;
  const d=new Date(s);if(!isNaN(d))return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
  return "";
}
function amount(v){if(typeof v==="number")return v;const n=parseFloat(String(v||"").replace(/[₹,\s]/g,""));return isNaN(n)?null:n}

/* ---------- auth ---------- */
async function login(email,password){
  const res=await fetch(SB_URL+"/auth/v1/token?grant_type=password",{method:"POST",headers:{"apikey":SB_KEY,"Content-Type":"application/json"},body:JSON.stringify({email,password})});
  const data=await res.json();if(!res.ok)throw new Error(data.error_description||data.msg||"Login failed");
  accessToken=data.access_token;localStorage.setItem("sterlion-auth-session",JSON.stringify({access_token:data.access_token,refresh_token:data.refresh_token}));
  return data.user;
}
async function adminCheck(user){
  try{const rows=await sb("ledger_admins?select=user_id&user_id=eq."+encodeURIComponent(user.id));return Array.isArray(rows)&&rows.some(x=>String(x.user_id)===String(user.id))}catch(e){return false}
}
