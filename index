/* ---------- import ---------- */
const headerMap={customer:["customer","customername","name","client","clientname"],nbfc:["nbfc","lender","nbfcname","loan","product"],invoice:["invoice","invoiceno","invoicenumber","reference","ref","referenceno"],amount:["amount","amountrs","amountinr","value","amountdue"],due:["duedate","due","date"],notes:["notes","note","remarks","comments"],status:["status","paidstatus"]};
function norm(s){return String(s||"").trim().toLowerCase().replace(/[^a-z]/g,"")}
function keyFor(h){const n=norm(h);for(const k in headerMap)if(headerMap[k].includes(n))return k;return null}
$("import-btn").onclick=()=>$("import-file").click();
$("import-file").onchange=async e=>{
  const file=e.target.files[0];if(!file)return;e.target.value="";
  try{
    const data=await file.arrayBuffer(),wb=XLSX.read(data,{type:"array",cellDates:true}),sheet=wb.Sheets[wb.SheetNames[0]],rows=XLSX.utils.sheet_to_json(sheet,{defval:""});
    if(!rows.length)throw new Error("No rows found.");
    const map={};Object.keys(rows[0]).forEach(h=>{const k=keyFor(h);if(k&&!map[k])map[k]=h});
    if(!map.customer)throw new Error('Could not find a Customer column.');
    const batchId=uid();const batch=batchId+"::"+file.name;const toAdd=[],skipped=[];
    const explicitNbfc=$("import-nbfc").value;
    rows.forEach((row,i)=>{
      const customer=String(row[map.customer]||"").trim(),a=map.amount?amount(row[map.amount]):null;
      if(!customer){skipped.push("Row "+(i+2)+": missing customer");return}
      if(a===null||a<=0){skipped.push("Row "+(i+2)+": invalid amount");return}
      let nbfc=map.nbfc?String(row[map.nbfc]||"").trim():"";
       const known=["Monedo","Blacksoil","Fintree","Term Loan"];
       const rawNbfc=String(nbfc||"").trim().toLowerCase();
       // Accept values such as MONEDO, MONEDO_SCF_PF, Monedo SCF, etc.
       const km=known.find(x=>{
         const k=x.toLowerCase();
         return rawNbfc===k || rawNbfc.startsWith(k+" ") || rawNbfc.startsWith(k+"_") || rawNbfc.includes(k);
       });
       if(km) nbfc=km;

       // If the row itself has no usable NBFC value, use what was explicitly
       // picked in the "This file is for" dropdown. Filename is a last resort.
       if(!nbfc){
         const fileName=file.name.toLowerCase();
         const fromFile=known.find(x=>fileName.includes(x.toLowerCase().replace(/\s+/g,"")) || fileName.includes(x.toLowerCase()));
         nbfc=explicitNbfc || fromFile || "";
       }
      let st="pending";if(map.status&&String(row[map.status]||"").trim().toLowerCase()==="paid")st="paid";
      toAdd.push({id:uid(),customer,nbfc,invoice:map.invoice?String(row[map.invoice]||"").trim():"",amount:a,due:map.due?parseDate(row[map.due]):"",notes:map.notes?String(row[map.notes]||"").trim():"",screenshot:null,status:st,createdAt:Date.now()+i,batch});
    });
    if(!toAdd.length)throw new Error("Nothing valid to import.");
    $("import-status").textContent=`Importing ${toAdd.length} entries…`;
    await insertRecords(toAdd);await refresh();
    const nbfcCounts={};toAdd.forEach(r=>{const k=r.nbfc||"(none)";nbfcCounts[k]=(nbfcCounts[k]||0)+1});
    const nbfcSummary=Object.keys(nbfcCounts).map(k=>`${k}: ${nbfcCounts[k]}`).join(", ");
    $("import-status").textContent=`Imported ${toAdd.length} entries (${nbfcSummary})${skipped.length?` • Skipped ${skipped.length}`:""}.`;
    $("import-nbfc").value="";
    banner("Import completed.");
  }catch(e){$("import-status").textContent="Import failed: "+e.message;$("import-status").style.color="var(--warn)"}
};

/* ---------- update Virtual Account Numbers from a separate file ---------- */
const vanHeaderMap={customer:["customername","name","clientname","buyername"],van:["virtualaccountnumber","virtualaccountno","van","account"],ifsc:["ifsc","ifsccode"],beneficiary:["beneficiaryname","accountname","beneficiary"]};
function vanKeyFor(h){const n=norm(h);for(const k in vanHeaderMap)if(vanHeaderMap[k].includes(n))return k;return null}
$("van-btn").onclick=()=>$("van-file").click();
$("van-file").onchange=async e=>{
  const file=e.target.files[0];if(!file)return;e.target.value="";
  $("van-status").style.color="";$("van-status").textContent="Reading file…";
  try{
    const data=await file.arrayBuffer(),wb=XLSX.read(data,{type:"array",cellDates:true}),sheet=wb.Sheets[wb.SheetNames[0]],rows=XLSX.utils.sheet_to_json(sheet,{defval:""});
    if(!rows.length)throw new Error("No rows found.");
    const map={};Object.keys(rows[0]).forEach(h=>{const k=vanKeyFor(h);if(k&&!map[k])map[k]=h});
    if(!map.customer||!map.van)throw new Error("Could not find customer_name / Virtual Account Number columns.");
    const nbfcFilter=$("van-nbfc").value;

    // Build lookup: normalized VAN-file customer name -> VAN value
    const vanRows=rows.map(row=>({
      name:String(row[map.customer]||"").trim(),
      norm:norm(row[map.customer]),
      van:String(row[map.van]||"").trim()
    })).filter(v=>v.name&&v.van);

    // Match against every currently loaded ledger entry by normalized name
    // (ledger customer names often carry an NBFC suffix, so this checks
    // whether the ledger name starts with the VAN file's plain name).
    const toUpdate=[];
    const matchedVanNames=new Set();
    state.records.forEach(r=>{
      if(nbfcFilter&&r.nbfc!==nbfcFilter)return;
      const rn=norm(r.customer);
      const hit=vanRows.find(v=>v.norm.length>3&&(rn.startsWith(v.norm)||rn.includes(v.norm)));
      if(hit&&r.van!==hit.van){toUpdate.push({r,van:hit.van});matchedVanNames.add(hit.name)}
    });

    if(!toUpdate.length){
      $("van-status").textContent="No matching ledger entries found to update. Check customer names match, or try a specific NBFC filter.";
      $("van-status").style.color="var(--warn)";
      return;
    }

    $("van-status").textContent=`Updating ${toUpdate.length} invoice(s)…`;
    for(const {r,van} of toUpdate){
      await sb("payment_ledger_entries?id=eq."+encodeURIComponent(r.id),{method:"PATCH",headers:{"Prefer":"return=minimal"},body:JSON.stringify({van})});
    }
    await refresh();
    const unmatchedCount=vanRows.length-matchedVanNames.size;
    $("van-status").style.color="";
    $("van-status").textContent=`Updated ${toUpdate.length} invoice(s) across ${matchedVanNames.size} customer(s).`+(unmatchedCount?` ${unmatchedCount} customer(s) in the file had no matching ledger entries.`:"");
    banner("Virtual account numbers updated.");
  }catch(e){$("van-status").textContent="Update failed: "+e.message;$("van-status").style.color="var(--warn)"}
};

/* ---------- imported file batches ---------- */
async function deleteImportedBatch(batchId){
  if(!currentIsAdmin) throw new Error("Only Admin can delete imported files.");

  const batch=String(batchId||"").trim();
  if(!batch) throw new Error("This import has no batch ID.");

  const rows=state.records.filter(r=>String(r.batch||"")===batch);
  if(!rows.length) throw new Error("No entries from this import were found.");

  // Delete the complete batch in one request. This is reliable for large
  // CSV files and avoids hundreds of separate DELETE calls.
  await sb(
    "payment_ledger_entries?import_batch_id=eq."+encodeURIComponent(batch),
    {
      method:"DELETE",
      headers:{"Prefer":"return=representation"}
    }
  );

  const remaining=await sb(
    "payment_ledger_entries?select=id&import_batch_id=eq."+encodeURIComponent(batch)
  );

  if(Array.isArray(remaining) && remaining.length){
    throw new Error(
      "Delete was blocked by Supabase Row Level Security. Check the DELETE policy and try again."
    );
  }

  return rows.length;
}

async function renderImportFiles(){
  const list={};

  state.records.filter(r=>r.batch).forEach(r=>{
    if(!list[r.batch]){
      list[r.batch]={
        batch:r.batch,
        count:0,
        amount:0,
        created:r.createdAt
      };
    }
    list[r.batch].count++;
    list[r.batch].amount+=r.amount;
    list[r.batch].created=Math.min(list[r.batch].created,r.createdAt);
  });

  const arr=Object.values(list).sort((a,b)=>b.created-a.created);

  if(!arr.length){
    $("file-list").innerHTML=
      '<div style="font-size:11px;color:var(--ink-soft);padding:8px 0">'+
      'No imported files yet. New imports will appear here with a delete option.'+
      '</div>';
    return;
  }

  $("file-list").innerHTML="";

  arr.forEach(x=>{
    const d=document.createElement("div");
    d.className="import-file-row";

    const info=document.createElement("div");
    const name=document.createElement("div");
    name.className="import-file-name";
    const rawBatch=String(x.batch||"");
    const sep=rawBatch.indexOf("::");
    const fileName=sep>=0 ? rawBatch.slice(sep+2) : "";
    name.textContent=fileName
      ? fileName
      : "Imported file • "+new Date(x.created).toLocaleString("en-IN");

    const meta=document.createElement("div");
    meta.className="import-file-meta";
    meta.textContent=x.count+" entries • "+money(x.amount);

    info.appendChild(name);
    info.appendChild(meta);

    const btn=document.createElement("button");
    btn.className="btn btn-danger";
    btn.type="button";
    btn.textContent="Delete file";

    btn.onclick=async e=>{
      e.preventDefault();
      e.stopPropagation();

      if(!currentIsAdmin){
        banner("Only Admin can delete imported files.","error");
        return;
      }

      const ok=confirm(
        "Delete this imported file?\n\n"+
        x.count+" entries • "+money(x.amount)+
        "\n\nThis will permanently delete all entries from this import."
      );
      if(!ok)return;

      const oldText=btn.textContent;
      btn.disabled=true;
      btn.textContent="Deleting…";

      try{
        const deleted=await deleteImportedBatch(x.batch);

        // Reload from Supabase so the screen exactly matches the database.
        await refresh();
        banner("Imported file deleted. "+deleted+" entries removed.");
      }catch(e){
        btn.disabled=false;
        btn.textContent=oldText;
        banner(e.message||"Could not delete imported file.","error");
      }
    };

    d.appendChild(info);
    d.appendChild(btn);
    $("file-list").appendChild(d);
  });
}

