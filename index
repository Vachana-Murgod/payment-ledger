(async()=>{try{if(accessToken){const res=await fetch(SB_URL+"/auth/v1/user",{headers:{"apikey":SB_KEY,"Authorization":"Bearer "+accessToken}});if(res.ok){const u=await res.json();await applyUser(u);return}}}catch(e){}document.body.classList.add("auth-required")})();
})();
