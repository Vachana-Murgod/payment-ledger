/* ---------- database records ---------- */
async function load(){
  const rows=await sb("payment_ledger_entries?select=*&order=created_at.desc");
  return (rows||[]).map(r=>({id:r.id,customer:r.customer,nbfc:r.nbfc||"",invoice:r.invoice||"",amount:Number(r.amount)||0,paidAmount:Number(r.paid_amount)||0,due:r.due||"",notes:r.notes||"",screenshot:r.screenshot||null,status:r.status||"pending",createdAt:Number(r.created_at)||Date.now(),batch:r.import_batch_id||"",phone:r.phone||"",van:r.van||""}));
}
async function insertRecords(list){
  if(!currentIsAdmin)throw new Error("Only Admin can modify entries.");
  if(!list.length)return;
  const rows=list.map(r=>({id:r.id,customer:r.customer,nbfc:r.nbfc||null,invoice:r.invoice||null,amount:Number(r.amount)||0,paid_amount:Number(r.paidAmount)||0,due:r.due||null,notes:r.notes||null,screenshot:r.screenshot||null,status:r.status||"pending",created_at:r.createdAt||Date.now(),import_batch_id:r.batch||null,phone:r.phone||null,van:r.van||null}));
  await sb("payment_ledger_entries?on_conflict=id",{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=minimal"},body:JSON.stringify(rows)});
}
async function updateRecord(r){
  if(!currentIsAdmin)throw new Error("Only Admin can modify entries.");
  await sb("payment_ledger_entries?id=eq."+encodeURIComponent(r.id),{method:"PATCH",headers:{"Prefer":"return=minimal"},body:JSON.stringify({customer:r.customer,nbfc:r.nbfc||null,invoice:r.invoice||null,amount:Number(r.amount)||0,paid_amount:Number(r.paidAmount)||0,due:r.due||null,notes:r.notes||null,screenshot:r.screenshot||null,status:r.status||"pending",phone:r.phone||null,van:r.van||null})});
}
async function deleteOne(r){
  if(!currentIsAdmin)throw new Error("Only Admin can delete entries.");
  await sb("payment_ledger_entries?id=eq."+encodeURIComponent(r.id),{method:"DELETE"});
}

