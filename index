function renderEntryRow(r, container){
  const eff=statusOf(r),row=document.createElement("div");row.className="row";
  const out=outstandingOf(r);
  const amountHtml=eff==="partial"?`${money(out)}<div style="font-size:10px;color:var(--ink-soft);font-weight:400">of ${money(r.amount)}</div>`:money(r.amount);
  row.innerHTML=`<div>${r.screenshot?`<img class="thumb" src="${r.screenshot}" alt="">`:`<div class="thumb placeholder">—</div>`}</div>
    <div><div class="customer">${esc(r.customer)}</div><div class="meta">${esc(r.nbfc||"")} ${r.invoice?" • Ref "+esc(r.invoice):""} • Due ${fmtDate(r.due)}</div></div>
    <div class="amount">${amountHtml}</div><div class="status ${eff}">${eff==="partial"?"partially paid":eff}</div>`;
  row.addEventListener("click",()=>{
    if(state.openId===r.id){state.openId=null;render();return}
    state.openId=r.id;render();
  });
  container.appendChild(row);
  if(state.openId===r.id){
    const d=document.createElement("div");d.className="detail";
    const paidLine=(Number(r.paidAmount)||0)>0?`<br><b>Amount paid so far:</b> ${money(r.paidAmount)}<br><b>Outstanding:</b> ${money(out)}`:"";
    d.innerHTML=`<div><div class="detail-notes"><b>Notes:</b> ${esc(r.notes||"No notes added.")}${paidLine}<br><br><b>Amount in words:</b> ${indianWords(r.amount)}</div><div class="detail-actions">
      ${eff!=="paid"?`<button class="btn btn-gold paid-control">Mark fully paid</button>`:""}
      <button class="btn btn-ghost edit-control">Edit</button><button class="btn btn-danger edit-control">Delete</button></div></div>
      <div class="detail-proof">${r.screenshot?`<img src="${r.screenshot}" alt="Payment proof">`:"<div class='empty' style='padding:20px'>No proof uploaded</div>"}</div>`;
    const paid=d.querySelector(".paid-control");if(paid)paid.onclick=async e=>{e.stopPropagation();try{r.status="paid";r.paidAmount=r.amount;await updateRecord(r);state.openId=null;await refresh();banner("Payment marked as paid.")}catch(x){banner(x.message,"error")}};
    const edit=d.querySelector(".edit-control");if(edit)edit.onclick=e=>{e.stopPropagation();startEdit(r)};
    const del=[...d.querySelectorAll(".btn-danger")][0];if(del)del.onclick=async e=>{e.stopPropagation();if(confirm("Delete this entry?")){try{await deleteOne(r);state.openId=null;await refresh()}catch(x){banner(x.message,"error")}}};
    d.addEventListener("click",e=>e.stopPropagation());container.appendChild(d);
  }
}
function buildCustomerReminder(g){
  const byNbfc={};
  g.entries.filter(r=>statusOf(r)!=="paid").forEach(r=>{
    const nb=r.nbfc||"Unspecified";
    if(!byNbfc[nb])byNbfc[nb]={entries:[],van:""};
    byNbfc[nb].entries.push(r);
    if(!byNbfc[nb].van&&r.van)byNbfc[nb].van=r.van;
  });
  const lines=[`Dear ${g.name},`,"","This is to inform you of the following pending invoices with Sterlion Finance:",""];
  Object.keys(byNbfc).forEach(nb=>{
    const grp=byNbfc[nb];
    const byDue={};
    grp.entries.forEach(r=>{
      const d=r.due||"";
      if(!byDue[d])byDue[d]={total:0,invoices:[]};
      byDue[d].total+=outstandingOf(r);
      if(r.invoice)byDue[d].invoices.push(r.invoice+((Number(r.paidAmount)||0)>0?` (part-paid, ${money(outstandingOf(r))} left)`:""));
    });
    lines.push(`— ${nb} —`);
    Object.keys(byDue).forEach(d=>{
      const b=byDue[d];
      lines.push(`Due ${d?fmtDate(d):"date not set"} — Total ${money(b.total)}`);
      if(b.invoices.length)lines.push(`Invoices: ${b.invoices.join(", ")}`);
    });
    const acct=NBFC_ACCOUNTS[nb];
    if(acct&&(acct.name||acct.ifsc||grp.van)){
      lines.push("For repayment, please transfer to:");
      if(acct.name)lines.push(`Account Name: ${acct.name}`);
      if(grp.van)lines.push(`Virtual Account No: ${grp.van}`);
      if(acct.ifsc)lines.push(`IFSC Code: ${acct.ifsc}`);
    }
    lines.push("");
  });
  lines.push(`Total outstanding across all invoices: ${money(g.outstanding)}`);
  lines.push("");
  lines.push("Kindly ensure timely payment to avoid any inconvenience.");
  lines.push("");
  lines.push("Regards,");
  lines.push("Sterlion Finance");
  return lines.join("\n");
}
function render(){
  const all=state.records;
  $("stat-count").textContent=all.length;
  $("stat-outstanding").textContent=money(all.reduce((a,r)=>a+outstandingOf(r),0));
  $("stat-collected").textContent=money(all.reduce((a,r)=>a+(Number(r.paidAmount)||0),0));
  const list=all.filter(r=>{
    if(state.filter!=="all"&&statusOf(r)!==state.filter)return false;
    if(state.nbfc&&r.nbfc!==state.nbfc)return false;
    if(state.search&&!(`${r.customer} ${r.invoice||""} ${r.notes||""}`.toLowerCase().includes(state.search)))return false;
    return true;
  });
  if(!list.length){$("ledger").innerHTML=`<div class="empty"><div class="big">${all.length?"Nothing matches":"No entries yet"}</div>${all.length?"Try another filter or search.":"Add an entry or import a file."}</div>`;return}
  $("ledger").innerHTML="";

  if(!state.groupByCustomer){
    list.forEach(r=>renderEntryRow(r,$("ledger")));
    return;
  }

  // Grouped-by-customer view: same customer may have invoices under several
  // NBFCs, so this groups across the currently filtered list regardless of
  // which lender each invoice belongs to.
  const groups={};
  list.forEach(r=>{
    const key=(r.customer||"").trim().toLowerCase()||"(no name)";
    if(!groups[key])groups[key]={name:r.customer||"(no name)",entries:[],outstanding:0,collected:0,nbfcs:{}};
    groups[key].entries.push(r);
    groups[key].collected+=(Number(r.paidAmount)||0);groups[key].outstanding+=outstandingOf(r);
    const nb=r.nbfc||"Unspecified";groups[key].nbfcs[nb]=(groups[key].nbfcs[nb]||0)+1;
  });
  const sortedKeys=Object.keys(groups).sort((a,b)=>groups[b].outstanding-groups[a].outstanding);

  sortedKeys.forEach(key=>{
    const g=groups[key];
    const card=document.createElement("div");card.className="row";card.style.cursor="pointer";
    const nbfcChips=Object.keys(g.nbfcs).map(n=>`${esc(n)}: ${g.nbfcs[n]}`).join(" · ");
    card.innerHTML=`<div><div class="thumb placeholder">${g.entries.length}</div></div>
      <div><div class="customer">${esc(g.name)}</div><div class="meta">${nbfcChips} • ${g.entries.length} invoice${g.entries.length===1?"":"s"}</div></div>
      <div class="amount">${money(g.outstanding)}<div style="font-size:10px;color:var(--ink-soft);font-weight:400">outstanding</div></div>
      <div class="status ${g.outstanding>0?"pending":"paid"}">${g.outstanding>0?"has dues":"all paid"}</div>`;
    card.addEventListener("click",()=>{
      state.openCustomer=(state.openCustomer===key)?null:key;
      state.openId=null;
      render();
    });
    $("ledger").appendChild(card);
    if(state.openCustomer===key){
      const wrap=document.createElement("div");wrap.className="detail";wrap.style.display="block";
      wrap.addEventListener("click",e=>e.stopPropagation());
      const actions=document.createElement("div");actions.style.cssText="grid-column:1 / -1;display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap";
      const phone=(g.entries.find(r=>r.phone)||{}).phone||"";
      actions.innerHTML=`<button class="btn btn-ghost" id="copy-reminder-${key.replace(/[^a-z0-9]/g,"")}">Copy WhatsApp reminder</button>${phone?`<a class="btn btn-gold" style="text-decoration:none" target="_blank" id="open-wa-${key.replace(/[^a-z0-9]/g,"")}">Open in WhatsApp</a>`:""}`;
      wrap.appendChild(actions);
      const sub=document.createElement("div");sub.style.gridColumn="1 / -1";
      g.entries.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)).forEach(r=>renderEntryRow(r,sub));
      wrap.appendChild(sub);
      $("ledger").appendChild(wrap);
      const safeKey=key.replace(/[^a-z0-9]/g,"");
      const copyBtn=document.getElementById("copy-reminder-"+safeKey);
      if(copyBtn)copyBtn.onclick=e=>{
        e.stopPropagation();
        const msg=buildCustomerReminder(g);
        navigator.clipboard.writeText(msg).then(()=>banner("Reminder copied — paste it into WhatsApp.")).catch(()=>{
          window.prompt("Copy this message:",msg);
        });
      };
      const waLink=document.getElementById("open-wa-"+safeKey);
      if(waLink){
        const digits=phone.replace(/[^0-9]/g,"");
        waLink.href="https://wa.me/"+digits+"?text="+encodeURIComponent(buildCustomerReminder(g));
      }
    }
  });
}
